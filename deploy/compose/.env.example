# Private local-model deployment; generate .env before use.
JINSHU_PROFILE=services
JINSHU_MODEL_SCOPE=local
JINSHU_ALLOW_EXTERNAL=0
JINSHU_BOOTSTRAP=0
JINSHU_EMBEDDED_WORKER=0
STORAGE_MODE=mongo
VECTOR_BACKEND=milvus
MONGODB_DB=jinshu
MONGO_PASSWORD=GENERATE
REDIS_PASSWORD=GENERATE
MINIO_USER=jinshu
MINIO_PASSWORD=GENERATE
AUTH_SECRET=GENERATE
INTERNAL_API_TOKEN=GENERATE
MODEL_GATEWAY_TOKEN=GENERATE
CHAT_API_KEY=GENERATE
EMBEDDING_API_KEY=GENERATE
RERANKER_API_KEY=GENERATE
RELAY_API_KEY=GENERATE
CHAT_BASE_URL=http://model-gateway:8200/v1
EMBEDDING_BASE_URL=http://model-gateway:8200/v1
RERANKER_BASE_URL=http://model-gateway:8200/v1
RELAY_BASE_URL=http://model-gateway:8200/v1
CHAT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_CHAT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
RELAY_MODEL=Qwen/Qwen2.5-0.5B-Instruct
EMBEDDING_PROVIDER=relay
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBEDDING_REVISION=main
LOCAL_EMBEDDING_REVISION=main
LOCAL_CHAT_REVISION=main
LOCAL_RERANKER_REVISION=main
MILVUS_COLLECTION=jinshu_fintech_bge_v4
MILVUS_TOKEN=
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-base
PI_AGENT_ENABLED=false
TIMEOUT_INTENT=60
TIMEOUT_RETRIEVAL=120
TIMEOUT_ANSWER=120
TIMEOUT_VERIFY=90
PI_RUNTIME_TIMEOUT_INTENT=60
PI_RUNTIME_TIMEOUT_REWRITE=60
PI_RUNTIME_TIMEOUT_ANSWER=120
PI_RUNTIME_TIMEOUT_VERIFY=90
MODEL_TIMEOUT=120
EMBEDDING_TIMEOUT=180
RETRIEVAL_MODEL_TIMEOUT=120
RERANKER_TIMEOUT=120
INDEX_TIMEOUT=600
CHAT_MAX_TOKENS=256
MODEL_MAX_OUTPUT=256
ASYNC_STREAM_NAME=jinshu:v4:jobs
LOOP_ROLLBACK_MIN_SAMPLES=10
LOOP_ROLLBACK_MARGIN=0.1
