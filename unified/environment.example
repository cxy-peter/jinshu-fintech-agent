# The default local and Vercel runtime needs ONLY this server-side model key.
# Never put a key in frontend code, GitHub source, screenshots or chat.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional: protect paid calls before publicly sharing the app. Minimum 12 chars.
JINSHU_ACCESS_CODE=
# Optional, bounded settings. Defaults are already usable.
MODEL_TIMEOUT=55
CHAT_MAX_TOKENS=1600
MAX_MODEL_CALLS_PER_HOUR=30
# No MongoDB/Redis/Milvus/Embedding/Reranker required in the default core runtime.
