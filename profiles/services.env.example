# No real credentials included. Copy to profiles/services.env (gitignored).
# This profile performs real external model calls ONLY after explicit opt-in.
JINSHU_PROFILE=services
JINSHU_ALLOW_EXTERNAL=1
JINSHU_EMBEDDED_WORKER=0
AUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX
INTERNAL_API_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN
MONGO_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MONGODB_DB=jinshu
STORAGE_MODE=mongo
VECTOR_BACKEND=milvus
# Milvus must be installed separately using its official compatible deployment.
MILVUS_URI=http://host.docker.internal:19530
MILVUS_COLLECTION=jinshu_fintech_chunks
MILVUS_TOKEN=
EMBEDDING_PROVIDER=relay
EMBEDDING_MODEL=REPLACE_WITH_AUTHORIZED_EMBEDDING_MODEL
EMBEDDING_DIM=1024
RELAY_BASE_URL=https://REPLACE_WITH_AUTHORIZED_GATEWAY/v1
RELAY_API_KEY=REPLACE_WITH_REAL_KEY
RELAY_MODEL=REPLACE_WITH_CHAT_MODEL
LLM_PROVIDER=relay
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
PI_AGENT_ENABLED=true
PI_AGENT_URL=http://pi-agent:8100
TIMEOUT_INTENT=10
TIMEOUT_RETRIEVAL=15
TIMEOUT_ANSWER=50
TIMEOUT_VERIFY=25
ASYNC_STREAM_NAME=jinshu:jobs
LOOP_ROLLBACK_MIN_SAMPLES=10
LOOP_ROLLBACK_MARGIN=0.1
